    <attribute side="server" code="0x0002" define="FLOW_RATIO"    type="int16u"    writable="true" default="0x0000" optional="false">FlowRatio</attribute>
    <attribute side="server" code="0x0003" define="DROP_RATIO"    type="int16s"    writable="true" default="0x0000" optional="false">DropRatio</attribute>
    <attribute side="server" code="0x0004" define="ALARM_BITMAP"  type="bitmap16"  writable="true" default="0x0000" optional="false">AlarmBitmap</attribute>
    <attribute side="server" code="0x0005" define="WEIGHT_G"        type="int16u" writable="true" default="0x0000" optional="false">WeightG</attribute>
    <attribute side="server" code="0x0006" define="DROPS_PER_MIN"   type="int16u" writable="true" default="0x0000" optional="false">DropsPerMin</attribute>
