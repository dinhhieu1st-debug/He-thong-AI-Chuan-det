    <attribute side="server" code="0x000B" define="HR_BASELINE_SECONDS_REMAINING" type="int8u" writable="true" default="0x00" optional="false">HrBaselineSecondsRemaining</attribute>
    <attribute side="server" code="0x000C" define="HR_BASELINE_BPM" type="int16u" writable="true" default="0x0000" optional="false">HrBaselineBpm</attribute>
    <attribute side="server" code="0x000D" define="TARE_EVENT_COUNT" type="int8u" writable="true" default="0x00" optional="false">TareEventCount</attribute>
    <attribute side="server" code="0x000E" define="HR_BASELINE_EVENT_COUNT" type="int8u" writable="true" default="0x00" optional="false">HrBaselineEventCount</attribute>
