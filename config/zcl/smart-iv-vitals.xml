<?xml version="1.0"?>
<configurator>
  <domain name="SmartIV"/>
  <cluster manufacturerCode="0x1049">
    <name>Smart IV Vitals</name>
    <domain>SmartIV</domain>
    <description>Custom cluster carrying Smart IV AI data (HR/SpO2/Flow/Drop/Alarm)</description>
    <code>0xFC01</code>
    <define>SMART_IV_VITALS_CLUSTER</define>
    <client init="false" tick="false">true</client>
    <server init="false" tick="false">true</server>
    <attribute side="server" code="0x0000" define="HEART_RATE"    type="int16s"    writable="true" default="0x0000" optional="false">HeartRate</attribute>
    <attribute side="server" code="0x0001" define="SPO2"          type="int16u"    writable="true" default="0x0000" optional="false">Spo2</attribute>
    <attribute side="server" code="0x0002" define="FLOW_RATIO"    type="int16u"    writable="true" default="0x0000" optional="false">FlowRatio</attribute>
    <attribute side="server" code="0x0003" define="DROP_RATIO"    type="int16s"    writable="true" default="0x0000" optional="false">DropRatio</attribute>
    <attribute side="server" code="0x0004" define="ALARM_BITMAP"  type="bitmap16"  writable="true" default="0x0000" optional="false">AlarmBitmap</attribute>
  </cluster>
</configurator>
